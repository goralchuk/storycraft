generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum BookStatus {
  DRAFT
  PENDING
  PROCESSING
  DONE
  FAILED
  CANCELLED
}

enum BookType {
  UNIQUE
  TEMPLATE
}

enum BookStage {
  HEROES
  STORY
  ILLUSTRATIONS
  ASSEMBLE
}

enum PageLayout {
  IMAGE_ONLY
  IMAGE_TEXT
  TEXT_ONLY
}

enum TaskStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum TaskType {
  GENERATE_TEXT
  GENERATE_IMAGE
  GENERATE_PDF
}

enum TemplateCategory {
  FANTASY
  ADVENTURE
  NATURE
  SCIENCE
  FRIENDSHIP
  ANIMALS
}

enum GenerationStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum WritingStyle {
  WATERCOLOR
  ADVENTURE
  FUNNY
  GENTLE
}

enum Role {
  USER
  ADMIN
}

enum HeroRole {
  MAIN
  PET
  SIBLING
  FRIEND
  MAGIC
}

enum HeroStatus {
  IDLE
  GENERATING
  DONE
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  avatarUrl     String?
  googleId      String?   @unique
  role          Role      @default(USER)
  balance       Int       @default(500)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  children         Child[]
  books            Book[]
  ratingsGiven     Rating[]
  referralsSent    Referral[]        @relation("referrer")
  referralUsed     Referral?         @relation("referee")
  coinTransactions CoinTransaction[]
}

model Child {
  id        String   @id @default(cuid())
  userId    String
  name      String
  birthDate DateTime?
  gender    String?
  interests String[]
  photoUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  books  Book[]
  heroes Hero[]
}

model Hero {
  id           String     @id @default(cuid())
  childId      String
  role         HeroRole
  name         String
  style        String?
  description  String?
  imageCaption String?
  personality  String?
  imageKey     String?
  freeAttempts Int        @default(3)
  status       HeroStatus @default(IDLE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
}

model Template {
  id             String            @id @default(cuid())
  title          String
  description    String?
  coverUrl       String?
  prompt         String
  pageCount      Int               @default(10)
  icon           String?
  category       TemplateCategory?
  ageRange       String?
  availablePages Int[]
  defaultTone    String?
  badge          String?
  coverColor     String?
  tags           Json?
  isActive       Boolean           @default(true)
  isCustomBase   Boolean           @default(false)
  createdAt      DateTime          @default(now())

  books    Book[]
  histories BookTemplateHistory[]
}

model Book {
  id           String        @id @default(cuid())
  userId       String
  childId      String?
  templateId   String?
  topicId      String?
  bookType     BookType      @default(UNIQUE)
  templateHistoryId String?
  title        String?
  pageCount    Int           @default(10)
  promptText   String?
  writingStyle WritingStyle?
  fear         String?
  photoUrl     String?
  slots        Json?
  status       BookStatus    @default(PENDING)
  stage        BookStage?
  progress     Int           @default(0)
  pdfUrl       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  child           Child?               @relation(fields: [childId], references: [id])
  template        Template?            @relation(fields: [templateId], references: [id])
  topic           Topic?               @relation(fields: [topicId], references: [id])
  templateHistory BookTemplateHistory? @relation(fields: [templateHistoryId], references: [id])
  pages           BookPage[]
  tasks           Task[]
  ratings         Rating[]
  generations     BookGeneration[]
}

model BookPage {
  id        String     @id @default(cuid())
  bookId    String
  pageNum   Int
  text      String?
  layout    PageLayout @default(IMAGE_TEXT)
  createdAt DateTime   @default(now())
  deletedAt DateTime?

  book          Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  illustrations Illustration[]

  @@unique([bookId, pageNum])
}

model Illustration {
  id            String   @id @default(cuid())
  bookPageId    String
  prompt        String?
  imageUrl      String?
  featuresChild Boolean  @default(false)
  createdAt     DateTime @default(now())
  deletedAt     DateTime?

  bookPage BookPage @relation(fields: [bookPageId], references: [id], onDelete: Cascade)
}

model Rating {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  score     Int
  comment   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
}

model Referral {
  id         String   @id @default(cuid())
  referrerId String
  refereeId  String   @unique
  createdAt  DateTime @default(now())

  referrer User @relation("referrer", fields: [referrerId], references: [id])
  referee  User @relation("referee", fields: [refereeId], references: [id])
}

model Task {
  id        String     @id @default(cuid())
  bookId    String
  type      TaskType
  status    TaskStatus @default(QUEUED)
  payload   Json?
  error     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

model Topic {
  id        String   @id @default(cuid())
  icon      String
  label     String
  prompts   String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  books Book[]
}

model AppSettings {
  id            String   @id @default("singleton")
  textProvider  String   @default("qwen")
  textModel     String   @default("qwen3.7-plus")
  imageProvider String   @default("qwen")
  imageModel    String   @default("qwen-image-2.0")
  updatedAt     DateTime @updatedAt
}

model CoinTransaction {
  id        String   @id @default(cuid())
  userId    String
  label     String
  amount    Int
  isIn      Boolean
  bookId    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PriceItem {
  key       String   @id
  label     String
  category  String
  amount    Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Visual style for a book (a prompt fragment for image generation). Chosen before
// heroes; prompt content authored by the product owner.
model StyleTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  previewUrl  String?
  prompt      String
  isActive    Boolean  @default(true)
  sort        Int      @default(0)
  createdAt   DateTime @default(now())
  deletedAt   DateTime?
}

// Per-size page layout: for each page, its layout and which characters appear.
// layout: [{ pageNum, layout: IMAGE_ONLY|IMAGE_TEXT|TEXT_ONLY, cast: ALL|MAIN|NONE|EXTRA, hasImage }]
model PageLayoutTemplate {
  id        String   @id @default(cuid())
  pageCount Int      @unique
  layout    Json
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  deletedAt DateTime?
}

// Orchestrator record for one generation run of a book (state + timing).
model BookGeneration {
  id          String           @id @default(cuid())
  bookId      String
  status      GenerationStatus @default(PENDING)
  currentStep String?
  progress    Int              @default(0)
  error       String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  book Book                @relation(fields: [bookId], references: [id], onDelete: Cascade)
  logs BookGenerationLog[]

  @@index([bookId])
}

// Per-step log of a generation run.
model BookGenerationLog {
  id           String   @id @default(cuid())
  generationId String
  step         String
  level        String   @default("info")
  message      String
  payload      Json?
  createdAt    DateTime @default(now())

  generation BookGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@index([generationId])
}

// Reusable, child-agnostic story: tokenized title/pages + slots schema + the
// assembled story prompt and style/theme refs. Re-render swaps the child slots.
model BookTemplateHistory {
  id              String   @id @default(cuid())
  title           String
  slots           Json
  pages           Json
  storyPrompt     String
  styleTemplateId String?
  themeTemplateId String?
  meta            Json?
  createdAt       DateTime @default(now())
  deletedAt       DateTime?

  theme Template? @relation(fields: [themeTemplateId], references: [id])
  books Book[]
}
