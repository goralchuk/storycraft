generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SubscriptionPlan {
  FREE
  BASIC
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
}

enum BookStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum TaskStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum TaskType {
  GENERATE_TEXT
  GENERATE_IMAGE
  GENERATE_PDF
}

enum TemplateCategory {
  FANTASY
  ADVENTURE
  NATURE
  SCIENCE
  FRIENDSHIP
  ANIMALS
}

enum WritingStyle {
  WATERCOLOR
  ADVENTURE
  FUNNY
  GENTLE
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  avatarUrl     String?
  googleId      String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  children      Child[]
  books         Book[]
  subscription  Subscription?
  ratingsGiven  Rating[]
  referralsSent Referral[] @relation("referrer")
  referralUsed  Referral?  @relation("referee")
}

model Child {
  id        String   @id @default(cuid())
  userId    String
  name      String
  birthDate DateTime?
  gender    String?
  interests String[]
  photoUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  books Book[]
}

model Template {
  id             String            @id @default(cuid())
  title          String
  description    String?
  coverUrl       String?
  prompt         String
  pageCount      Int               @default(10)
  icon           String?
  category       TemplateCategory?
  ageRange       String?
  availablePages Int[]
  defaultTone    String?
  badge          String?
  coverColor     String?
  tags           Json?
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())

  books Book[]
}

model Book {
  id           String        @id @default(cuid())
  userId       String
  childId      String
  templateId   String
  topicId      String?
  title        String?
  pageCount    Int           @default(10)
  promptText   String?
  writingStyle WritingStyle?
  fear         String?
  photoUrl     String?
  slots        Json?
  status       BookStatus    @default(PENDING)
  pdfUrl       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  child     Child         @relation(fields: [childId], references: [id])
  template  Template      @relation(fields: [templateId], references: [id])
  topic     Topic?        @relation(fields: [topicId], references: [id])
  pages     BookPage[]
  tasks     Task[]
  ratings   Rating[]
}

model BookPage {
  id        String   @id @default(cuid())
  bookId    String
  pageNum   Int
  text      String?
  createdAt DateTime @default(now())

  book          Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  illustrations Illustration[]

  @@unique([bookId, pageNum])
}

model Illustration {
  id            String   @id @default(cuid())
  bookPageId    String
  prompt        String?
  imageUrl      String?
  featuresChild Boolean  @default(false)
  createdAt     DateTime @default(now())

  bookPage BookPage @relation(fields: [bookPageId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Rating {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  score     Int
  comment   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
}

model Referral {
  id         String   @id @default(cuid())
  referrerId String
  refereeId  String   @unique
  createdAt  DateTime @default(now())

  referrer User @relation("referrer", fields: [referrerId], references: [id])
  referee  User @relation("referee", fields: [refereeId], references: [id])
}

model Task {
  id        String     @id @default(cuid())
  bookId    String
  type      TaskType
  status    TaskStatus @default(QUEUED)
  payload   Json?
  error     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

model Topic {
  id        String   @id @default(cuid())
  icon      String
  label     String
  prompts   String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  books Book[]
}

model AppSettings {
  id            String   @id @default("singleton")
  textProvider  String   @default("stub")
  textModel     String   @default("gpt-4o-mini")
  imageProvider String   @default("stub")
  imageModel    String   @default("dall-e-3")
  updatedAt     DateTime @updatedAt
}
